const state = {
  authToken: localStorage.getItem('shadowToken') || '',
  activeConversationId: null,
  language: localStorage.getItem('shadowLang') || 'en',
  conversations: [],
};

const translations = {
  en: {
    newChat: 'New Chat',
    chat: 'Chat',
    research: 'Research',
    coding: 'Coding',
    files: 'Files',
    memory: 'Memory',
    settings: 'Settings',
    online: 'Online',
    workspace: 'Workspace',
    send: 'Send',
    askPlaceholder: 'Ask SHADOW AI…',
    researchNow: 'Research',
    generate: 'Generate',
    analyzeFile: 'Analyze File',
    saveMemory: 'Save Memory',
    saveSettings: 'Save Settings',
    provider: 'Provider',
    model: 'Model',
  },
  hi: {
    newChat: 'नया चैट',
    chat: 'चैट',
    research: 'रिसर्च',
    coding: 'कोडिंग',
    files: 'फ़ाइलें',
    memory: 'मेमोरी',
    settings: 'सेटिंग्स',
    online: 'ऑनलाइन',
    workspace: 'वर्कस्पेस',
    send: 'भेजें',
    askPlaceholder: 'SHADOW AI से पूछें…',
    researchNow: 'रिसर्च करें',
    generate: 'जेनरेट करें',
    analyzeFile: 'फ़ाइल विश्लेषण',
    saveMemory: 'मेमोरी सेव करें',
    saveSettings: 'सेटिंग्स सेव करें',
    provider: 'प्रदाता',
    model: 'मॉडल',
  },
};

const els = {
  chatForm: document.getElementById('chatForm'),
  chatInput: document.getElementById('chatInput'),
  chatMessages: document.getElementById('chatMessages'),
  conversationList: document.getElementById('conversationList'),
  researchForm: document.getElementById('researchForm'),
  researchInput: document.getElementById('researchInput'),
  researchOutput: document.getElementById('researchOutput'),
  codeForm: document.getElementById('codeForm'),
  codeInput: document.getElementById('codeInput'),
  codeOutput: document.getElementById('codeOutput'),
  fileForm: document.getElementById('fileForm'),
  fileInput: document.getElementById('fileInput'),
  fileOutput: document.getElementById('fileOutput'),
  memoryForm: document.getElementById('memoryForm'),
  memoryInput: document.getElementById('memoryInput'),
  memoryOutput: document.getElementById('memoryOutput'),
  langToggle: document.getElementById('langToggle'),
  newChatBtn: document.getElementById('newChatBtn'),
  exportBtn: document.getElementById('exportBtn'),
  logoutBtn: document.getElementById('logoutBtn'),
  providerSelect: document.getElementById('providerSelect'),
  modelInput: document.getElementById('modelInput'),
  saveSettingsBtn: document.getElementById('saveSettingsBtn'),
  currentConversationTitle: document.getElementById('currentConversationTitle'),
};

function applyTranslations() {
  const locale = translations[state.language] || translations.en;
  document.querySelectorAll('[data-i18n]').forEach((node) => {
    const key = node.dataset.i18n;
    if (locale[key]) {
      node.textContent = locale[key];
    }
  });

  document.querySelectorAll('[data-i18n-placeholder]').forEach((node) => {
    const key = node.dataset.i18nPlaceholder;
    if (locale[key]) {
      node.placeholder = locale[key];
    }
  });
}

function setPanel(panelId) {
  document.querySelectorAll('.nav-item').forEach((item) => {
    item.classList.toggle('active', item.dataset.panel === panelId);
  });
  document.querySelectorAll('.panel').forEach((panel) => {
    panel.classList.toggle('active', panel.id === panelId);
  });
}

function createMessageBubble(message) {
  const messageEl = document.createElement('div');
  messageEl.className = `message ${message.role}`;
  messageEl.innerHTML = renderMarkdown(message.content);
  return messageEl;
}

function renderMarkdown(text) {
  const escaped = escapeHtml(text)
    .replace(/\n/g, '<br>')
    .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
    .replace(/\*(.*?)\*/g, '<em>$1</em>')
    .replace(/`([^`]+)`/g, '<code>$1</code>');

  return escaped;
}

function escapeHtml(value) {
  return value.replace(/[&<>"']/g, (char) => ({
    '&': '&amp;',
    '<': '&lt;',
    '>': '&gt;',
    '"': '&quot;',
    "'": '&#039;',
  }[char]));
}

async function api(path, options = {}) {
  const response = await fetch(path, {
    ...options,
    headers: {
      'Content-Type': 'application/json',
      ...(state.authToken ? { Authorization: `Bearer ${state.authToken}` } : {}),
      ...(options.headers || {}),
    },
  });

  const data = await response.json().catch(() => ({}));
  if (!response.ok) {
    throw new Error(data.error || 'Request failed');
  }

  return data;
}

async function login() {
  try {
    const auth = await api('/api/auth/login', {
      method: 'POST',
      body: JSON.stringify({ username: 'admin', password: 'shadow-ai' }),
    });
    state.authToken = auth.token;
    localStorage.setItem('shadowToken', auth.token);
    await loadConversations();
  } catch (error) {
    console.error('Login failed', error);
  }
}

async function loadConversations() {
  try {
    const conversations = await api('/api/conversations');
    state.conversations = conversations;
    renderConversationList();
    if (conversations.length) {
      selectConversation(conversations[0].id);
    }
  } catch (error) {
    console.error(error);
  }
}

function renderConversationList() {
  els.conversationList.innerHTML = '';
  state.conversations.forEach((conversation) => {
    const button = document.createElement('button');
    button.className = 'conversation-pill';
    button.textContent = conversation.title;
    button.addEventListener('click', () => selectConversation(conversation.id));
    els.conversationList.appendChild(button);
  });
}

async function selectConversation(conversationId) {
  state.activeConversationId = conversationId;
  const conversation = state.conversations.find((item) => item.id === conversationId);
  if (!conversation) return;

  els.currentConversationTitle.textContent = conversation.title;
  els.chatMessages.innerHTML = '';
  conversation.messages.forEach((message) => {
    els.chatMessages.appendChild(createMessageBubble(message));
  });
}

async function newConversation() {
  const conversation = await api('/api/conversations', {
    method: 'POST',
    body: JSON.stringify({ title: 'New conversation' }),
  });
  state.conversations.unshift(conversation);
  renderConversationList();
  selectConversation(conversation.id);
}

async function sendChat(event) {
  event.preventDefault();
  const prompt = els.chatInput.value.trim();
  if (!prompt) return;

  if (!state.activeConversationId) {
    await newConversation();
  }

  const payload = { conversationId: state.activeConversationId, prompt };
  els.chatInput.value = '';

  const userBubble = createMessageBubble({ role: 'user', content: prompt });
  els.chatMessages.appendChild(userBubble);

  const response = await api('/api/chat', {
    method: 'POST',
    body: JSON.stringify(payload),
  });

  const bubble = createMessageBubble({ role: 'assistant', content: response.message.content });
  els.chatMessages.appendChild(bubble);
  await loadConversations();
}

async function handleResearch(event) {
  event.preventDefault();
  const question = els.researchInput.value.trim();
  if (!question) return;

  const result = await api('/api/research', {
    method: 'POST',
    body: JSON.stringify({ question }),
  });

  let html = `<h4>Summary</h4><p>${escapeHtml(result.summary)}</p>`;
  if (result.sources && result.sources.length) {
    html += '<div class="source-list">';
    result.sources.forEach((source) => {
      html += `<div class="source-item"><strong>${escapeHtml(source.title)}</strong><br><a href="${source.url}" target="_blank" rel="noreferrer">${escapeHtml(source.url)}</a><br>${escapeHtml(source.snippet)}</div>`;
    });
    html += '</div>';
  }
  els.researchOutput.innerHTML = html;
}

async function handleCode(event) {
  event.preventDefault();
  const prompt = els.codeInput.value.trim();
  if (!prompt) return;

  const result = await api('/api/chat', {
    method: 'POST',
    body: JSON.stringify({ conversationId: state.activeConversationId || null, prompt: `You are a coding assistant. ${prompt}` }),
  });

  els.codeOutput.innerHTML = `<pre>${escapeHtml(result.message.content)}</pre>`;
}

async function handleFileUpload(event) {
  event.preventDefault();
  const file = els.fileInput.files[0];
  if (!file) return;

  const formData = new FormData();
  formData.append('file', file);

  const response = await fetch('/api/files/analyze', {
    method: 'POST',
    headers: {
      Authorization: `Bearer ${state.authToken}`,
    },
    body: formData,
  });

  const data = await response.json();
  if (!response.ok) {
    throw new Error(data.error || 'File analysis failed');
  }

  const result = data.result;
  els.fileOutput.innerHTML = `
    <strong>${escapeHtml(result.fileName)}</strong><br>
    <code>${escapeHtml(result.mimeType)}</code><br>
    <p>${escapeHtml(result.summary)}</p>
    <pre>${escapeHtml(result.text)}</pre>
  `;
}

async function saveMemory(event) {
  event.preventDefault();
  const content = els.memoryInput.value.trim();
  if (!content) return;

  const memory = await api('/api/memory', {
    method: 'POST',
    body: JSON.stringify({ content, source: 'web-ui', consent: true }),
  });

  els.memoryInput.value = '';
  await loadMemories();
  if (memory) {
    els.memoryOutput.innerHTML = `Saved memory: ${escapeHtml(memory.content)}`;
  }
}

async function loadMemories() {
  try {
    const data = await api('/api/memory');
    const list = data.memories || [];
    if (!list.length) {
      els.memoryOutput.innerHTML = 'No saved memories yet.';
      return;
    }

    els.memoryOutput.innerHTML = list.map((item) => `<div class="source-item">${escapeHtml(item.content)}</div>`).join('');
  } catch (error) {
    els.memoryOutput.innerHTML = 'Memory service unavailable.';
  }
}

async function saveSettings() {
  const provider = els.providerSelect.value;
  const model = els.modelInput.value.trim();
  await api('/api/settings', {
    method: 'POST',
    body: JSON.stringify({ provider, model }),
  });
  alert('Settings saved. Actual secrets remain server-side in environment variables.');
}

function handleLogout() {
  localStorage.removeItem('shadowToken');
  state.authToken = '';
  window.location.reload();
}

function handleExport() {
  if (!state.activeConversationId) return;
  window.open(`/api/conversations/${state.activeConversationId}/export`, '_blank');
}

function bindEvents() {
  document.querySelectorAll('.nav-item').forEach((button) => {
    button.addEventListener('click', () => setPanel(button.dataset.panel));
  });

  els.langToggle.addEventListener('click', () => {
    state.language = state.language === 'en' ? 'hi' : 'en';
    localStorage.setItem('shadowLang', state.language);
    applyTranslations();
  });

  els.newChatBtn.addEventListener('click', newConversation);
  els.exportBtn.addEventListener('click', handleExport);
  els.logoutBtn.addEventListener('click', handleLogout);
  els.chatForm.addEventListener('submit', sendChat);
  els.researchForm.addEventListener('submit', handleResearch);
  els.codeForm.addEventListener('submit', handleCode);
  els.fileForm.addEventListener('submit', handleFileUpload);
  els.memoryForm.addEventListener('submit', saveMemory);
  els.saveSettingsBtn.addEventListener('click', saveSettings);
}

async function boot() {
  bindEvents();
  applyTranslations();
  await login();
  await loadMemories();
  setPanel('chat-panel');
}

boot();
